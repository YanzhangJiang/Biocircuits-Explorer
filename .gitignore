*.pem
*.key
*.crt
*.cer
*.cert
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
known_hosts

# Cognito / OAuth client secrets dumps (this project uses Cognito)
*cognito*secret*
*client_secret*
*jwt*.json

# --- IDE / editor / tool state ---
.vscode/
.idea/
.cursor/
.history/
*.swp
*.swo

# Unify Claude config across all subtrees (supersedes /.claude/ + webapp/.claude/).
**/.claude/
**/.openai/
**/.anthropic/
**/.gemini/
**/.continue/
**/.cline/
**/.aider*

