.DS_Store
__pycache__/
*.pyc
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

.julia_packaging_depot/
dist/

frontend-swift/**/xcuserdata/
frontend-swift/**/.DS_Store

/.claude/
webapp/.claude/

# Atlas databases and generated local stores.
atlas_store/
**/atlas_store/
webapp/job_store/
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.duckdb
*.duckdb.wal

# Local docs, reports, and TeX drafts.
doc/
docs/
wiki/
reports/
request_doc/
test/
tests/
**/test/
**/tests/
*.tex
*.doc
*.docx
*.pdf

# Periodic table runtime outputs can grow quickly; keep generated runs local.
results/periodic_table/runs/*
!results/periodic_table/runs/.gitkeep
results/periodic_table/latest
scratch/
logs/

# Local deployment environment generated by deploy/setup_aws_batch.sh.
deploy/aws-runtime.env
deploy/aws-batch-stack.env

# --- Secrets / credentials (catch-all). Allow only *.example variants. ---
.env
.env.*
*.env
!*.env.example
!deploy/aws-runtime.env.example

# AWS / cloud credentials
.aws/
aws-credentials*
**/credentials
**/credentials.json

# SSH / TLS / signing keys
*.pem
*.key
*.crt
*.cer
*.cert
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
known_hosts

# Cognito / OAuth client secrets dumps (this project uses Cognito)
*cognito*secret*
*client_secret*
*jwt*.json

# --- IDE / editor / tool state ---
.vscode/
.idea/
.cursor/
.history/
*.swp
*.swo

# Unify Claude config across all subtrees (supersedes /.claude/ + webapp/.claude/).
**/.claude/

# --- Language / tooling caches (future-proofing) ---
node_modules/
webapp/public/js/dist/
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Julia local dev overrides
LocalPreferences.toml
deps/build.log

# --- Misc local runtime / backups ---
.taildrop_inbox*/
*.bak
*.tmp
*.orig
