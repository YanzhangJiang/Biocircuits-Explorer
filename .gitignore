.DS_Store
__pycache__/
*.pyc
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

.julia_packaging_depot/
dist/

frontend-swift/**/xcuserdata/
frontend-swift/**/.DS_Store

/.claude/
webapp/.claude/

# Atlas databases and generated local stores.
atlas_store/
**/atlas_store/
webapp/job_store/
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.duckdb
*.duckdb.wal

# Derived label corpora (latent-atlas-*-v0): large (datasets/ ~382 MB: dataset.jsonl,
# splits/*.json ~26 MB each, *_labels.jsonl, shards) and REGENERABLE from the atlas — keep
# local, like the atlas DBs above. Otherwise `git add .` would stage hundreds of MB.
datasets/
# Raw SQL dumps (e.g. the biocircuits-design-extract export) — large, never commit.
*.sql
# Local mirror of the design-system skill (byte-identical to .claude/skills/, already ignored).
design/
# DesignAgentTrace store (traces.jsonl + artifacts/) — local runtime evidence, can grow.
traces/
# Superpowers SDD dev-process scaffolding (task briefs/reports + progress ledger).
.superpowers/
# Atlas-derived slice dumps (regenerable; large). Ignore the scratch/duplicate dumps,
# but TRACK the paper's bundled reduced dataset (the notebooks read it offline; the full
# atlas is not bundled, so this 14 MB extract is the paper's reproducibility input).
webapp/data/
**/slices.jsonl.gz
!paper_rop_periodic_table/data/slices.jsonl.gz

# Local docs, reports, and TeX drafts.
doc/
docs/
wiki/
reports/
request_doc/
test/
tests/
**/test/
**/tests/

# …but the checked-in webapp test suite (Julia runtests.jl + JS *.test.mjs) and
# the Bnc_julia math-core golden suite are real source, not ad-hoc/generated
# output. Re-include them so new tests there are visible to git and CI rather than
# silently ignored (CI runs both webapp/test and Bnc_julia/test).
!webapp/test/
!webapp/test/**
!Bnc_julia/test/
!Bnc_julia/test/**
!/tests/
!/tests/**
/tests/**/__pycache__/
/tests/**/*.pyc

*.tex
*.doc
*.docx
*.pdf
*.bib
*.ris
*.nbib
*.enw

# Unpublished research material and site-specific operational scripts must stay
# in their private workspaces. The repository verifier rejects tracked copies.
/paper_rop_periodic_table/
/webapp/scripts/rop_periodic_table/
/webapp/scripts/_archive/
/workstation/
/paper/
/papers/
/manuscript/
/manuscripts/
/unpublished/
/private/
/confidential/

# Periodic table runtime outputs can grow quickly; keep generated runs local.
results/periodic_table/runs/*
!results/periodic_table/runs/.gitkeep
results/periodic_table/latest
scratch/
logs/

# Local deployment environment generated by deploy/setup_aws_batch.sh.
deploy/aws-runtime.env
deploy/aws-batch-stack.env

# --- Secrets / credentials (catch-all). Allow only *.example variants. ---
.env
.env.*
*.env
!*.env.example
!deploy/aws-runtime.env.example

# AWS / cloud credentials
.aws/
aws-credentials*
**/credentials
**/credentials.json

