# Copy to deploy/aws-runtime.env on the website host before running
# deploy/deploy.sh, or source it before starting the local backend on macOS.

# Filled with the immutable version-revision image emitted by build_image.sh.
# Example shape: <aws-account-id>.dkr.ecr.<region>.amazonaws.com/biocircuits-explorer:<version>-<revision>
BIOCIRCUITS_EXPLORER_IMAGE=

# Optional: registry region for the ECR docker login when the image above
# lives in ECR. The registry hostname already encodes the region; set this
# only to override.
# AWS_REGION=us-west-2
