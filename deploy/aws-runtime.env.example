# Copy to deploy/aws-runtime.env on an EC2 website host, or source it before
# starting the local backend on macOS.
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# The pushed application/worker image.
BIOCIRCUITS_EXPLORER_IMAGE=234270344246.dkr.ecr.us-west-2.amazonaws.com/biocircuits-explorer:latest

# Filled by deploy/setup_aws_batch.sh after AWS Batch/S3 resources exist.
BIOCIRCUITS_EXPLORER_AWS_BATCH_JOB_QUEUE=biocircuits-explorer-queue
BIOCIRCUITS_EXPLORER_AWS_BATCH_JOB_DEFINITION=biocircuits-explorer-worker
BIOCIRCUITS_EXPLORER_AWS_BATCH_ARTIFACT_PREFIX=s3://biocircuits-explorer-234270344246-us-west-2/jobs
BIOCIRCUITS_EXPLORER_AWS_BATCH_JOB_NAME_PREFIX=biocircuits
