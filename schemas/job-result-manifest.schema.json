{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biocircuits-explorer.com/schemas/job-result-manifest.schema.json",
  "title": "Biocircuits Explorer Asynchronous Job Result Manifest",
  "description": "Small commit marker published only after an asynchronous result object is complete. Brokers validate this manifest plus object metadata without downloading and materializing the potentially large result payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "kind",
    "created_at",
    "artifact_identity",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "bne-job-result-manifest/v1.0.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Canonical UTC timestamp produced by the worker when it commits the manifest, with second precision and a trailing Z."
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_schema_version",
        "algorithm_name",
        "algorithm_version",
        "config_hash",
        "artifact_metadata_hash"
      ],
      "properties": {
        "artifact_schema_version": {
          "const": "bne-result/v1.0.0"
        },
        "algorithm_name": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "artifact_metadata_hash": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "content_length",
        "sha256",
        "media_type",
        "payload_key_count"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "content_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Exact serialized result size in bytes; intentionally unbounded because valid Atlas artifacts may be large."
        },
        "sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "media_type": {
          "const": "application/json"
        },
        "payload_key_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of top-level computed payload keys beside the sibling artifact metadata."
        }
      }
    }
  },
  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
