{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biocircuits-explorer.com/schemas/release-candidate-evidence.schema.json",
  "title": "Biocircuits Explorer release-candidate external evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_candidate",
    "generated_at",
    "overall_status",
    "source",
    "lanes"
  ],
  "properties": {
    "schema_version": { "const": "bne-release-candidate-evidence/v1.0.0" },
    "release_candidate": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "overall_status": {
      "enum": ["not_run", "in_progress", "passed", "failed", "blocked"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "configuration_sha256", "image_digest", "macos_artifact_sha256"],
      "properties": {
        "commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "dirty": { "type": ["boolean", "null"] },
        "configuration_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "image_digest": {
          "oneOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "macos_artifact_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "compose_tls", "aws", "slurm", "macos"],
      "properties": {
        "registry": { "$ref": "#/$defs/lane" },
        "compose_tls": { "$ref": "#/$defs/lane" },
        "aws": { "$ref": "#/$defs/lane" },
        "slurm": { "$ref": "#/$defs/lane" },
        "macos": { "$ref": "#/$defs/lane" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "overall_status": { "const": "passed" } },
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "dirty": { "const": false },
              "configuration_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "macos_artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "lanes": {
            "properties": {
              "registry": { "properties": { "status": { "const": "passed" } } },
              "compose_tls": { "properties": { "status": { "const": "passed" } } },
              "aws": { "properties": { "status": { "const": "passed" } } },
              "slurm": { "properties": { "status": { "const": "passed" } } },
              "macos": { "properties": { "status": { "const": "passed" } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "environment", "evidence", "rollback"],
      "properties": {
        "status": { "enum": ["not_run", "in_progress", "passed", "failed", "blocked"] },
        "environment": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "rollback": { "$ref": "#/$defs/rollback" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "environment": { "type": "string", "minLength": 1 },
              "evidence": { "minItems": 1 },
              "rollback": {
                "anyOf": [
                  {
                    "required": ["result"],
                    "properties": {
                      "status": { "const": "passed" },
                      "observed_at": { "type": "string", "format": "date-time" },
                      "output_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "result": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "required": ["result"],
                    "properties": {
                      "status": { "const": "not_applicable" },
                      "result": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at", "command", "output_sha256", "artifacts"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "command": { "type": "string", "minLength": 1 },
        "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "type": "string" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at", "output_sha256"],
      "properties": {
        "status": { "enum": ["not_run", "not_applicable", "passed", "failed"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "output_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "result": { "type": "string" }
      }
    }
  }
}
