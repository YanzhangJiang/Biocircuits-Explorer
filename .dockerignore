# Keep Docker builds focused on the source tree required by deploy/Dockerfile.
# Local atlas/job stores can be very large and must not be baked into images.
*

!VERSION

!Bnc_julia/
!Bnc_julia/**

!webapp/
!webapp/Project.toml
!webapp/Manifest.toml
!webapp/*.jl
!webapp/start.sh
!webapp/src/
!webapp/src/**
!webapp/public/
!webapp/public/**
!webapp/scripts/
!webapp/scripts/**

!deploy/
!deploy/Dockerfile

.git
.git/**
webapp/atlas_store
webapp/atlas_store/**
webapp/job_store
webapp/job_store/**
webapp/.julia
webapp/.julia/**
webapp/.cache
webapp/.cache/**
webapp/tmp
webapp/tmp/**
webapp/logs
webapp/logs/**
