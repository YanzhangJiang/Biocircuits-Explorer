+    # Scale exp10(b): exp10(b) = 10^d * exp10(b-d)
+    d = maximum(b)
+    vscaled = exp10.(Float64.(b) .- d)               # in (0,1]
+    yscaled = Vector{Float64}(undef, size(Γ,1))
